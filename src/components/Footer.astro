---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__grid">
      <div class="footer__brand">
        <span class="footer__logo-text">VGJoyasGT</span>
        <p class="footer__text">Joyas artesanales hechas a mano, diseñadas especialmente para ti.</p>
      </div>
      <div class="footer__links">
        <h4 class="footer__title">Enlaces</h4>
        <a href="#inicio">Inicio</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#productos">Productos</a>
        <a href="#contacto">Contacto</a>
      </div>
      <div class="footer__social">
        <h4 class="footer__title">Síguenos</h4>
        <div class="footer__social-links">
          <a href="https://instagram.com/vgjoyasgt" target="_blank" rel="noopener" aria-label="Instagram">
            <InstagramIcon />
          </a>
          <a href="https://wa.me/50255117308" target="_blank" rel="noopener" aria-label="WhatsApp">
            <WhatsAppIcon />
          </a>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__copyright">© {currentYear} VGJoyasGT. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
