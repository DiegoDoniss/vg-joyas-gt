---
import Button from './Button.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import HandIcon from './icons/HandIcon.astro';
import socialData from '../data/social.json';

const { whatsapp } = socialData;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__contact">
    <p class="footer__text">
      ¿Listo para tu joya perfecta? Contáctanos por WhatsApp o Instagram para hacer tu pedido personalizado.
    </p>
    <div class="footer__buttons">
      <Button href={whatsapp} variant="primary" target="_blank" rel="noopener">
        <WhatsAppIcon /> WhatsApp
      </Button>
      <Button href="https://instagram.com/vgjoyasgt" variant="secondary" target="_blank" rel="noopener">
        <InstagramIcon /> Instagram
      </Button>
    </div>
    <p class="footer__custom">
      <HandIcon /> También aceptamos diseños personalizados
    </p>
  </div>
  <div class="footer__bottom">
    <p class="footer__copyright">© {currentYear} VGJoyasGT. Todos los derechos reservados.</p>
  </div>
</footer>
