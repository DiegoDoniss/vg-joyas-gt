---
interface Props {
  id?: string;
  variant?: 'default' | 'dark' | 'alt';
  class?: string;
}

const { id, variant = 'default', class: className = '' } = Astro.props;
---

<section id={id} class={`section section--${variant} ${className}`}>
  <div class="section__container">
    <slot />
  </div>
</section>
